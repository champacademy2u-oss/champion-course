rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{videoId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      // Viewers do not read directly with Firebase SDK.
      // Vercel API verifies the video password and returns a short-lived signed URL.
      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
