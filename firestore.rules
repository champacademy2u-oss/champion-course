rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SECURITY MODEL
    // app.js signs in ANONYMOUSLY (firebase.auth().signInAnonymously()) before
    // any read/write. Anonymous Auth satisfies `request.auth != null`, so the
    // database is no longer publicly readable by anyone on the internet — only
    // by a Firebase Auth user of THIS project. For a single-operator CRM this
    // closes the open-access hole while keeping the code simple.
    //
    // REQUIRED BEFORE DEPLOYING THESE RULES:
    //   1. In the Firebase console → Authentication → Sign-in method, ENABLE
    //      "Anonymous". Otherwise signInAnonymously() fails and the app falls
    //      back to localStorage (it will NOT crash).
    //   2. The web API key in config.js is public by design; these rules are
    //      what actually protect the data.
    //
    // FUTURE HARDENING (optional): restrict to a specific operator uid, e.g.
    //   allow read, write: if request.auth != null
    //     && request.auth.uid == "YOUR_OPERATOR_UID";
    // or add per-user `ownerId` fields. Not required for single-user use.

    // Default-deny: only authenticated (anonymous) requests are allowed.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
