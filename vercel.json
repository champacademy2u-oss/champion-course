{
  "version": 2,
  "builds": [
    {
      "src": "api/admin-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin-token.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/config.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/email-campaigns.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/email-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/public-video.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/settings.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/upload-url.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/videos.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/watch-start.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/watch-update.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/zoom.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://champacademy2u-oss.github.io"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/crm-session",
      "dest": "/api/admin-token.js?mode=crm-session"
    },
    {
      "src": "/api/customer-receipts",
      "dest": "/api/email-campaigns.js"
    },
    {
      "src": "/api/champ-library",
      "dest": "/api/email-campaigns.js"
    },
    {
      "src": "/api/preview-registration",
      "dest": "/api/zoom.js?action=registerPreviewLead"
    },
    {
      "src": "/api/unsubscribe",
      "dest": "/api/email-campaigns.js"
    },
    {
      "src": "/api/email-track",
      "dest": "/api/email-campaigns.js"
    },
    {
      "src": "/api/email-image",
      "dest": "/api/email-campaigns.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/watch/([^/]+)",
      "dest": "/public/watch.html"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
